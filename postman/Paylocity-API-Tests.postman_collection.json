					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"//Generat a random valid value (0-32)\r",
									"let randomDependants = Math.floor(Math.random() * 33); \r",
									"\r",
									"// Generate a random string for the name\r",
									"let randomSuffix = Math.random().toString(36).substring(2, 7); \r",
									"\r",
									"// Concat the name plus random string\r",
									"let randomFirstName = \"newName_\" + randomSuffix; \r",
									"\r",
									"// Save as env variables\r",
									"pm.environment.set(\"randomDependants\", randomDependants);\r",
									"pm.environment.set(\"randomFirstName\", randomFirstName);\r",
									"\r",
									"// Console logs\r",
									"console.log(\"Generated dependants:\", randomDependants);\r",
									"console.log(\"Generated firstName:\", randomFirstName);\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"  pm.response.to.have.status(200);",
									"});",
									"",
									"let emp;",
									"pm.test(\"Response is an object with expected fields\", function () {",
									"  emp = pm.response.json();",
									"  pm.expect(emp).to.be.an(\"object\");",
									"  [\"id\",\"firstName\",\"lastName\",\"dependants\"].forEach(k =>",
									"    pm.expect(emp, `missing ${k}`).to.have.property(k)",
									"  );",
									"});",
									"",
									"pm.test(\"Save employeeId\", function () {",
									"  pm.collectionVariables.set(\"employeeId\", String(emp.id));",
									"  pm.expect(pm.collectionVariables.get(\"employeeId\")).to.be.a(\"string\");",
									"});",
									"",
									"pm.test(\"Dependants in range 0..32\", function () {",
									"  pm.expect(emp.dependants).to.be.a(\"number\");",
									"  pm.expect(emp.dependants).to.be.within(0, 32);",
									"});",
									"",
									"pm.test(\"Benefits cost per pay is correct (±0.05)\", function () {",
									"  const expectedAnnual = 1000 + 500 * emp.dependants;",
									"  const expectedPerPay = expectedAnnual / 26;",
									"  pm.expect(emp.benefitsCost).to.be.closeTo(expectedPerPay, 0.05);",
									"});",
									"",
									"const created = pm.response.json();",
									"if (created && created.id) {",
									"  pm.collectionVariables.set(\"employeeId\", String(created.id));",
									"}",
									"",
									"pm.environment.unset(\"randomDependants\");",
									"pm.environment.unset(\"randomFirstName\");"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
