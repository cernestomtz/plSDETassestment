				{
					"name": "PUT Employee (edit using {{employeeId}})",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Verify employee was updated\", function (done) {",
									"    const e = pm.response.json();",
									"",
									"    pm.sendRequest({",
									"        url: `${pm.environment.get(\"baseUrl\")}/api/Employees`,",
									"        method: 'GET',",
									"        header: { \"Authorization\": pm.environment.get(\"auth\") }",
									"    }, function (err, res) {",
									"        pm.expect(res).to.have.status(200);",
									"        const employees = res.json();",
									"        const updated = employees.find(emp => emp.id === e.id);",
									"",
									"        pm.expect(updated).to.exist;",
									"        pm.expect(updated.firstName).to.eql(e.firstName);",
									"        pm.expect(updated.lastName).to.eql(e.lastName);",
									"        pm.expect(updated.dependants).to.eql(e.dependants);",
									"        done();",
									"    });",
									"});",
									"",
									"",
									"pm.test(\"Benefit cost and net pay are correctly calculated\", function () {",
									"    const e = pm.response.json();",
									"    const expectedAnnual = 1000 + (500 * e.dependants);",
									"    const expectedPerPay = expectedAnnual / 26;",
									"    const expectedNet = e.gross - expectedPerPay;",
									"",
									"    pm.expect(e.benefitsCost).to.be.closeTo(expectedPerPay, 0.05);",
									"    pm.expect(e.net).to.be.closeTo(expectedNet, 0.05);",
									"});",
									"",
									"pm.environment.unset(\"putFirstName\");",
									"pm.environment.unset(\"putDependants\");"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
