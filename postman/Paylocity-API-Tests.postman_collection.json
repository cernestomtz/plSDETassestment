									"// Generate a random string for the name\r",
									"let randomSuffix = Math.random().toString(36).substring(2, 7); \r",
									"\r",
									"// Concat the name plus random string\r",
									"let randomFirstName = \"newName_\" + randomSuffix; \r",
									"\r",
									"// Generate a random integer from 0 to 32\r",
									"let num = Math.floor(Math.random() * 33);\r",
									"let numStr = num.toString().padStart(2, '0');  // Ensure 2 digits, e.g. \"07\"\r",
									"\r",
									"// Generate random invalid suffix\r",
									"let chars = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%^&*\";\r",
									"let suffix = '';\r",
									"for (let i = 0; i < 4; i++) {   \r",
									"    suffix += chars.charAt(Math.floor(Math.random() * chars.length));\r",
									"}\r",
									"\r",
									"// Combine number + invalid part (example: \"07ab!K\")\r",
									"let validDependants = numStr + suffix;\r",
									"\r",
									"// Save to env\r",
									"pm.environment.set(\"validMixedDependants\", validDependants);\r",
									""
